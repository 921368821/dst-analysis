{
  "name": "engine-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "分层、接口优先的 2.5D 游戏引擎内核（对标 Unity/Cocos 的架构水准）",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-transform-types --test tests/run.ts",
    "test:arch": "node --experimental-transform-types --test tests/arch/layers.test.ts",
    "check": "npm run typecheck && npm run test",
    "sample:headless": "node --experimental-transform-types samples/headless.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
